DB_NAME=cryptobot

DB_ROOT_USER=admin
DB_ROOT_PASSWORD=password
DB_ROOT_EMAIL=admin@example.com

DB_BOT_USER=botuser
DB_BOT_PASSWORD=botpassword

#MONGO
MONGO_DB_PORT=27017

#POSTGRESQL
PG_DB_PORT=5432

# BINANCE API
BINANCE_API_KEY=xxxxxx
BINANCE_API_SECRET=xxxxxx

# SCRAPER
SCRAPER_INDEX_LIMIT=2 # Nb de pages traitées
SCRAPER_ENRICH_LIMIT=50 # Nb d'articles enrichis
SCRAPER_DETECT_LIMIT=1000 # Nb d'articles dans lesquels détecter les cryptos

SCRAPER_FEATURE_SENTIMENT_LIMIT=100 # Nb d'articles à traiter lors de l'analyse de sentiment

# API
API_PORT=8000

# CONFIGURATION DOCKER
DOCKER_REGISTRY="robdeopaproject/" # Indiquer ici le pseudo dockerhub ex: batman/ pour le mode prod et local/ pour le mode dev
BUILD_CONTEXT_DEV="" # Laisser vide pour le mode prod et mettre . pour le mode dev

# NOM DES IMAGES A INDIQUER
# ELLES CORRESPONDENT A L'IMAGE PYTHON DE BASE UTILISEE DANS PLUSIEURS CONTENEURS
# ICI CE SONT LES VALEURS DE DEV.
# A REMPLACE PAR "cryptobot-python-base:latest" POUR LE MODE PROD
IMG_MONGO_INIT="cryptobot-python-base:latest"
IMG_POSTGRES_INIT="cryptobot-python-base:latest"
IMG_API="cryptobot-python-base:latest"
IMG_COLLECTOR="cryptobot-python-base:latest"
IMG_TRANSFORMER="cryptobot-python-base:latest"
IMG_HISTORIC="cryptobot-python-base:latest"